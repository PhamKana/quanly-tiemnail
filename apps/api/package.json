{
  "name": "@nail-manager/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=../../dist/server.cjs",
    "start": "cross-env NODE_ENV=production node ../../dist/server.cjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate:commissions": "tsx scripts/migrate-commissions.ts"
  },
  "dependencies": {
    "@nail-manager/shared": "1.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.1.0",
    "vite": "^6.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
